# Firebase Configuration (required)
# Get these from: https://console.firebase.google.com → Project Settings → General
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:your_app_id_here

# Application Master Key (required)
# This is the password used to access the TrustGuard PRO dashboard
REACT_APP_MASTER_KEY=your_master_key_here
